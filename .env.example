# DABS-TOTALITY- hybrid scaffold — environment variable NAMES only.
# NEVER put real secret values in this file, in code, or in chat.
# Real keys arrive via the Secure Vault and are set as environment
# variables (or secret_ref pointers) on the hosting service.
#
# Known state on the existing Render workflow service (2026-11-20/21):
# - RENDER_WEBHOOK_SECRET exists ONLY as a Secret File. The start command
#   reads it from the environment, so it MUST also be set as a regular
#   environment variable or registration fails ("RENDER_WEBHOOK_SECRET is not set").
# - SHOPIFY_WEBHOOK_SECRET is set as an env var; whether its value matches
#   Shopify Admin -> Settings -> Webhooks is UNVERIFIED.

# --- Webhook verification secrets (values supplied via Secure Vault) ---
RENDER_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
SQUARE_WEBHOOK_SECRET=

# --- Infrastructure connection strings (values supplied via Secure Vault) ---
DATABASE_URL=
REDIS_URL=

# --- Temporal ---
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=purchase-saga

# --- Provider API credentials (values supplied via Secure Vault) ---
STRIPE_API_KEY=
SQUARE_ACCESS_TOKEN=
CASHAPP_API_KEY=
