# DABS / Totality Webhook Receiver — environment variable NAMES only.
# Set real values in the Render dashboard (or a local .env you never commit).

# Render webhook signing secret (from the Render webhook you create for this service)
RENDER_WEBHOOK_SECRET=
# Render API token used to enrich webhook events (events/deploys/services lookups).
# The upstream example README calls this RENDER_API_KEY; this code reads RENDER_API_TOKEN.
RENDER_API_TOKEN=
# Optional override for the Render API base URL
RENDER_API_URL=https://api.render.com/v1

# Admin key guarding /webhooks/commerce and /api/totality/split-preview (x-admin-api-key header)
ADMIN_API_KEY=

# Seven Sins Ops Engine bridge
SEVEN_SINS_ENGINE_URL=https://seven-sins-ops-engine.onrender.com
# Bridge target path. Default /api/events/ingest is NOT a route on the live
# engine (verified route inventory, 2026-11-22) — set this once the real
# ingest route is confirmed.
SEVEN_SINS_INGEST_PATH=/api/events/ingest

# HubSpot private app token (sync is skipped when unset)
HUBSPOT_ACCESS_TOKEN=

# Port (Render sets this automatically)
PORT=3001
